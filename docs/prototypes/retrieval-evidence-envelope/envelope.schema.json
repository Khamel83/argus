{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:argus:prototype:retrieval-evidence-envelope:1",
  "title": "PROTOTYPE canonical retrieval evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prototype_schema",
    "scenario",
    "contract_version",
    "request",
    "plan",
    "cache",
    "readiness",
    "origin_provider_attempts",
    "provider_attempts",
    "fusion",
    "extractions",
    "composition",
    "accounting",
    "acceptance",
    "final"
  ],
  "properties": {
    "prototype_schema": {"const": "argus.retrieval-evidence.prototype.v1"},
    "scenario": {"type": "string", "minLength": 1, "maxLength": 64},
    "contract_version": {"const": "2.0"},
    "request": {"$ref": "#/$defs/request"},
    "plan": {"$ref": "#/$defs/plan"},
    "cache": {"$ref": "#/$defs/cache"},
    "readiness": {
      "type": "array",
      "maxItems": 14,
      "items": {"$ref": "#/$defs/readiness"}
    },
    "origin_provider_attempts": {
      "type": "array",
      "maxItems": 14,
      "items": {"$ref": "#/$defs/providerAttempt"}
    },
    "provider_attempts": {
      "type": "array",
      "maxItems": 14,
      "items": {"$ref": "#/$defs/providerAttempt"}
    },
    "fusion": {"$ref": "#/$defs/fusion"},
    "extractions": {
      "type": "array",
      "maxItems": 200,
      "items": {"$ref": "#/$defs/extraction"}
    },
    "composition": {"$ref": "#/$defs/composition"},
    "accounting": {"$ref": "#/$defs/accounting"},
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "final": {"$ref": "#/$defs/final"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "shortLabel": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp": {"type": ["string", "null"], "format": "date-time"},
    "outcome": {
      "enum": [
        "success",
        "degraded",
        "empty",
        "invalid_request",
        "authentication_rejected",
        "policy_rejected",
        "timeout",
        "persistence_failed",
        "providers_failed",
        "extraction_failed",
        "unready"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "egress", "machine", "source_type", "observed_at"],
      "properties": {
        "producer": {"$ref": "#/$defs/shortLabel"},
        "egress": {"enum": ["residential", "datacenter", "local", "unknown"]},
        "machine": {"$ref": "#/$defs/shortLabel"},
        "source_type": {"$ref": "#/$defs/shortLabel"},
        "observed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "run_id",
        "caller_ref",
        "mode",
        "query_hash",
        "raw_query_retained",
        "deadline_ms",
        "received_at"
      ],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "caller_ref": {"$ref": "#/$defs/id"},
        "mode": {"enum": ["discovery", "grounding", "recovery", "research"]},
        "query_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "raw_query_retained": {"const": false},
        "deadline_ms": {"type": "integer", "minimum": 1, "maximum": 120000},
        "received_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "cache_fingerprint",
        "schema_version",
        "profile",
        "intent",
        "result_limit",
        "candidate_providers",
        "controls",
        "artifact_requirement_ref",
        "versions"
      ],
      "properties": {
        "plan_id": {"$ref": "#/$defs/id"},
        "cache_fingerprint": {"$ref": "#/$defs/id"},
        "schema_version": {"const": 1},
        "profile": {"enum": ["free", "budgeted"]},
        "intent": {"enum": ["discovery", "grounding", "recovery", "research"]},
        "result_limit": {"type": "integer", "minimum": 1, "maximum": 50},
        "candidate_providers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/shortLabel"}
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "safe_search",
            "country",
            "language",
            "freshness",
            "domains",
            "revalidation",
            "egress_preference",
            "effective_max_provider_tier",
            "include_attribution"
          ],
          "properties": {
            "safe_search": {"type": "boolean"},
            "country": {"type": ["string", "null"], "maxLength": 8},
            "language": {"type": ["string", "null"], "maxLength": 16},
            "freshness": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "maximum_cache_age_ms"],
              "properties": {
                "start": {"$ref": "#/$defs/timestamp"},
                "end": {"$ref": "#/$defs/timestamp"},
                "maximum_cache_age_ms": {"type": "integer", "minimum": 0}
              }
            },
            "domains": {
              "type": "object",
              "additionalProperties": false,
              "required": ["include", "exclude"],
              "properties": {
                "include": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"$ref": "#/$defs/shortLabel"}
                },
                "exclude": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"$ref": "#/$defs/shortLabel"}
                }
              }
            },
            "revalidation": {"enum": ["normal", "force"]},
            "egress_preference": {
              "enum": ["residential", "datacenter", "any"]
            },
            "effective_max_provider_tier": {"enum": [0, 1, 3]},
            "include_attribution": {"type": "boolean"}
          }
        },
        "artifact_requirement_ref": {
          "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "query_normalization",
            "routing_policy",
            "spend_policy",
            "freshness_policy",
            "domain_policy",
            "ranking_policy",
            "result_normalization",
            "extraction_outcome_policy"
          ],
          "properties": {
            "query_normalization": {"$ref": "#/$defs/id"},
            "routing_policy": {"$ref": "#/$defs/id"},
            "spend_policy": {"$ref": "#/$defs/id"},
            "freshness_policy": {"$ref": "#/$defs/id"},
            "domain_policy": {"$ref": "#/$defs/id"},
            "ranking_policy": {"$ref": "#/$defs/id"},
            "result_normalization": {"$ref": "#/$defs/id"},
            "extraction_outcome_policy": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason",
        "served",
        "age_ms",
        "maximum_age_ms",
        "origin_run_ref",
        "origin_provider_refs",
        "origin_spend",
        "new_provider_calls"
      ],
      "properties": {
        "decision": {"enum": ["hit", "miss", "bypassed", "rejected"]},
        "reason": {"$ref": "#/$defs/shortLabel"},
        "served": {"type": "boolean"},
        "age_ms": {"type": ["integer", "null"], "minimum": 0},
        "maximum_age_ms": {"type": "integer", "minimum": 0},
        "origin_run_ref": {
          "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        },
        "origin_provider_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/shortLabel"}
        },
        "origin_spend": {
          "oneOf": [{"$ref": "#/$defs/spend"}, {"type": "null"}]
        },
        "new_provider_calls": {"type": "integer", "minimum": 0, "maximum": 14}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "tier",
        "decision",
        "reason",
        "compatibility",
        "reachability",
        "usability",
        "cooldown",
        "spend",
        "snapshot_ref",
        "scope_ref",
        "observed_at",
        "valid_until"
      ],
      "properties": {
        "provider": {"$ref": "#/$defs/shortLabel"},
        "tier": {"enum": [0, 1, 3]},
        "decision": {
          "enum": [
            "eligible",
            "policy_skipped",
            "unavailable",
            "cooldown",
            "spend_blocked",
            "compatibility_unproven"
          ]
        },
        "reason": {"$ref": "#/$defs/shortLabel"},
        "compatibility": {"enum": ["compatible", "incompatible", "unknown"]},
        "reachability": {"enum": ["reachable", "unreachable", "unknown"]},
        "usability": {"enum": ["usable", "empty", "unusable", "unknown"]},
        "cooldown": {"enum": ["clear", "active", "half_open_claimed"]},
        "spend": {
          "enum": [
            "not_applicable",
            "unknown",
            "available",
            "low",
            "exhausted",
            "uncertain",
            "policy_denied"
          ]
        },
        "snapshot_ref": {"$ref": "#/$defs/id"}
        ,
        "scope_ref": {"$ref": "#/$defs/id"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "valid_until": {"$ref": "#/$defs/timestamp"}
      }
    },
    "spend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reserved_usd", "actual_usd", "reconciliation", "source"],
      "properties": {
        "reserved_usd": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{9}$"},
        "actual_usd": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{9}$"},
        "reconciliation": {
          "enum": ["confirmed", "estimated", "uncertain", "not_applicable"]
        },
        "source": {"$ref": "#/$defs/shortLabel"}
      }
    },
    "providerAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "run_ref",
        "provider",
        "ordinal",
        "outcome",
        "reason",
        "result_count",
        "latency_ms",
        "applied_controls_ref",
        "applied_controls",
        "provenance",
        "spend"
      ],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/id"},
        "run_ref": {"$ref": "#/$defs/id"},
        "provider": {"$ref": "#/$defs/shortLabel"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 13},
        "outcome": {
          "enum": [
            "success",
            "empty",
            "invalid_request",
            "authentication_rejected",
            "policy_rejected",
            "rate_limited",
            "balance_exhausted",
            "timeout",
            "provider_unavailable",
            "parse_error"
          ]
        },
        "reason": {"$ref": "#/$defs/shortLabel"},
        "result_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "latency_ms": {"type": "integer", "minimum": 0},
        "applied_controls_ref": {"$ref": "#/$defs/id"},
        "applied_controls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "safe_search",
            "freshness_translation",
            "domain_translation",
            "request_class"
          ],
          "properties": {
            "safe_search": {"enum": ["applied", "unsupported", "not_requested"]},
            "freshness_translation": {
              "enum": ["exact", "widened", "unsupported", "not_requested"]
            },
            "domain_translation": {
              "enum": ["exact", "post_filter", "unsupported", "not_requested"]
            },
            "request_class": {"$ref": "#/$defs/shortLabel"}
          }
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "spend": {"$ref": "#/$defs/spend"}
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "attempt_ref", "provider_rank", "numerator", "denominator"],
      "properties": {
        "provider": {"$ref": "#/$defs/shortLabel"},
        "attempt_ref": {"$ref": "#/$defs/id"},
        "provider_rank": {"type": "integer", "minimum": 0},
        "numerator": {"const": 1},
        "denominator": {"type": "integer", "minimum": 61}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "passed", "published_at", "observed_at", "reason", "proof"],
      "properties": {
        "required": {"type": "boolean"},
        "passed": {"type": ["boolean", "null"]},
        "published_at": {"$ref": "#/$defs/timestamp"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "reason": {"$ref": "#/$defs/shortLabel"},
        "proof": {"enum": ["approved_publication", "not_required", "unproven"]}
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_id",
        "url",
        "title",
        "site_key",
        "base_rank",
        "output_rank",
        "cluster_sort_key",
        "best_provider_rank",
        "contributor_count",
        "smallest_provider",
        "exact_score",
        "contributions",
        "freshness",
        "provenance",
        "extraction_link"
      ],
      "properties": {
        "cluster_id": {"$ref": "#/$defs/id"},
        "url": {"type": "string", "format": "uri", "maxLength": 8192},
        "title": {"type": "string", "minLength": 1, "maxLength": 1000},
        "site_key": {"$ref": "#/$defs/shortLabel"},
        "base_rank": {"type": "integer", "minimum": 0},
        "output_rank": {"type": "integer", "minimum": 0},
        "cluster_sort_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "best_provider_rank": {"type": "integer", "minimum": 0},
        "contributor_count": {"type": "integer", "minimum": 1, "maximum": 14},
        "smallest_provider": {"$ref": "#/$defs/shortLabel"},
        "exact_score": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {"type": "integer", "minimum": 1},
            "denominator": {"type": "integer", "minimum": 1}
          }
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "items": {"$ref": "#/$defs/contribution"}
        },
        "freshness": {"$ref": "#/$defs/freshness"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "extraction_link": {
          "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        }
      }
    },
    "fusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ranking_policy",
        "rrf_k",
        "clusters",
        "filtered_observations",
        "floor"
      ],
      "properties": {
        "ranking_policy": {"$ref": "#/$defs/id"},
        "rrf_k": {"const": 60},
        "clusters": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/cluster"}
        },
        "filtered_observations": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "provider_rank", "reason"],
            "properties": {
              "provider": {"$ref": "#/$defs/shortLabel"},
              "provider_rank": {"type": "integer", "minimum": 0},
              "reason": {"$ref": "#/$defs/shortLabel"}
            }
          }
        },
        "floor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_clusters", "required_sites", "passed", "reason"],
          "properties": {
            "required_clusters": {"type": "integer", "minimum": 0, "maximum": 50},
            "required_sites": {"type": "integer", "minimum": 0, "maximum": 50},
            "passed": {"type": "boolean"},
            "reason": {"$ref": "#/$defs/shortLabel"}
          }
        }
      }
    },
    "extractionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ordinal",
        "extractor",
        "decision",
        "attempt_outcome",
        "latency_ms",
        "reason",
        "provenance",
        "spend"
      ],
      "properties": {
        "kind": {"enum": ["cache", "extractor"]},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 15},
        "extractor": {"type": ["string", "null"], "maxLength": 64},
        "decision": {
          "enum": ["miss", "hit_eligible", "hit_ineligible", "invoked", "policy_skipped"]
        },
        "attempt_outcome": {
          "enum": [
            null,
            "content",
            "empty",
            "adapter_request_rejected",
            "provider_authentication_rejected",
            "provider_policy_rejected",
            "rate_limited",
            "balance_exhausted",
            "timeout",
            "provider_unavailable",
            "parse_error",
            "unknown_failure"
          ]
        },
        "latency_ms": {"type": ["integer", "null"], "minimum": 0},
        "reason": {"$ref": "#/$defs/shortLabel"},
        "provenance": {
          "oneOf": [{"$ref": "#/$defs/provenance"}, {"type": "null"}]
        },
        "spend": {
          "oneOf": [{"$ref": "#/$defs/spend"}, {"type": "null"}]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "disposition",
        "quality_passed",
        "is_complete",
        "citation_eligible",
        "content_hash",
        "provenance"
      ],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "disposition": {"enum": ["usable", "partial", "diagnostic_only", "none"]},
        "quality_passed": {"type": ["boolean", "null"]},
        "is_complete": {"type": ["boolean", "null"]},
        "citation_eligible": {"type": "boolean"},
        "content_hash": {"type": ["string", "null"], "pattern": "^(sha256:[0-9a-f]{64})?$"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rejection_id",
        "code",
        "recommended_action",
        "provider",
        "attempt_count",
        "last_status",
        "total_attempt_latency_ms"
      ],
      "properties": {
        "rejection_id": {"$ref": "#/$defs/id"},
        "code": {
          "enum": [
            "quality_gate_failed",
            "incomplete_content",
            "provider_unavailable",
            "timeout",
            "parse_error",
            "unsupported_source",
            "rate_limited",
            "empty_result"
          ]
        },
        "recommended_action": {
          "enum": ["retry_later", "terminal", "fallback_provider"]
        },
        "provider": {"type": ["string", "null"], "maxLength": 64},
        "attempt_count": {"type": "integer", "minimum": 0, "maximum": 16},
        "last_status": {"type": ["string", "null"], "maxLength": 64},
        "total_attempt_latency_ms": {"type": "integer", "minimum": 0}
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extraction_run_id",
        "cluster_ref",
        "plan_ref",
        "outcome",
        "partial_allowed",
        "steps",
        "selected_extractor",
        "artifact",
        "rejection",
        "acceptance_receipt_ref"
      ],
      "properties": {
        "extraction_run_id": {"$ref": "#/$defs/id"},
        "cluster_ref": {"$ref": "#/$defs/id"},
        "plan_ref": {"$ref": "#/$defs/id"},
        "outcome": {"$ref": "#/$defs/outcome"},
        "partial_allowed": {"type": "boolean"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/extractionStep"}
        },
        "selected_extractor": {"type": ["string", "null"], "maxLength": 64},
        "artifact": {
          "oneOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]
        },
        "rejection": {
          "oneOf": [{"$ref": "#/$defs/rejection"}, {"type": "null"}]
        },
        "acceptance_receipt_ref": {
          "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_requirement_ref",
        "artifact_requirement",
        "retrieval_outcome",
        "artifact_outcome",
        "composite_outcome",
        "links",
        "accepted_artifact_refs",
        "degraded_artifact_refs",
        "rejected_extraction_refs"
      ],
      "properties": {
        "artifact_requirement_ref": {
          "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        },
        "artifact_requirement": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requirement_ref",
                "aggregate_count",
                "minimum_disposition",
                "max_extractions",
                "deadline_ms",
                "spend_policy_ref"
              ],
              "properties": {
                "requirement_ref": {"$ref": "#/$defs/id"},
                "aggregate_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "minimum_disposition": {"enum": ["usable", "partial"]},
                "max_extractions": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "deadline_ms": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 120000
                },
                "spend_policy_ref": {"$ref": "#/$defs/id"}
              }
            },
            {"type": "null"}
          ]
        },
        "retrieval_outcome": {"$ref": "#/$defs/outcome"},
        "artifact_outcome": {
          "oneOf": [{"$ref": "#/$defs/outcome"}, {"type": "null"}]
        },
        "composite_outcome": {"$ref": "#/$defs/outcome"},
        "links": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "link_id",
              "cluster_ref",
              "extraction_run_ref",
              "outcome",
              "artifact_disposition",
              "artifact_ref",
              "rejection_ref",
              "required"
            ],
            "properties": {
              "link_id": {"$ref": "#/$defs/id"},
              "cluster_ref": {"$ref": "#/$defs/id"},
              "extraction_run_ref": {
                "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
              },
              "outcome": {"$ref": "#/$defs/outcome"},
              "artifact_disposition": {
                "enum": ["usable", "partial", "diagnostic_only", "none"]
              },
              "artifact_ref": {
                "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
              },
              "rejection_ref": {
                "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
              },
              "required": {"type": "boolean"}
            }
          }
        },
        "accepted_artifact_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "degraded_artifact_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "rejected_extraction_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_call_count",
        "extractor_call_count",
        "reserved_usd",
        "actual_usd",
        "reconciliation",
        "source",
        "operation_latency_ms",
        "provider_attempt_latency_ms",
        "extractor_attempt_latency_ms"
      ],
      "properties": {
        "provider_call_count": {"type": "integer", "minimum": 0, "maximum": 14},
        "extractor_call_count": {"type": "integer", "minimum": 0, "maximum": 3200},
        "reserved_usd": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{9}$"},
        "actual_usd": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{9}$"},
        "reconciliation": {
          "enum": ["confirmed", "estimated", "uncertain", "not_applicable"]
        },
        "source": {"$ref": "#/$defs/shortLabel"},
        "operation_latency_ms": {"type": "integer", "minimum": 0, "maximum": 120000},
        "provider_attempt_latency_ms": {"type": "integer", "minimum": 0},
        "extractor_attempt_latency_ms": {"type": "integer", "minimum": 0}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "receipt_ref", "accepted_at", "artifact_count", "cache_published"],
      "properties": {
        "status": {"enum": ["accepted", "failed"]},
        "receipt_ref": {
          "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
        },
        "accepted_at": {"$ref": "#/$defs/timestamp"},
        "artifact_count": {"type": "integer", "minimum": 0, "maximum": 200},
        "cache_published": {"type": "boolean"}
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation_id", "cluster_ref", "artifact_ref"],
      "properties": {
        "citation_id": {"$ref": "#/$defs/id"},
        "cluster_ref": {"$ref": "#/$defs/id"},
        "artifact_ref": {"$ref": "#/$defs/id"}
      }
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "result_refs",
        "diagnostic_result_refs",
        "citations",
        "answer",
        "caller_result",
        "synthesis_allowed",
        "delivery_allowed",
        "visible_labels"
      ],
      "properties": {
        "outcome": {"$ref": "#/$defs/outcome"},
        "result_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "diagnostic_result_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "citations": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/citation"}
        },
        "answer": {"type": "null"},
        "caller_result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["results", "citation_refs", "answer"],
          "properties": {
            "results": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cluster_ref",
                  "url",
                  "title",
                  "rank",
                  "visibility",
                  "extraction"
                ],
                "properties": {
                  "cluster_ref": {"$ref": "#/$defs/id"},
                  "url": {"type": "string", "format": "uri", "maxLength": 8192},
                  "title": {"type": "string", "minLength": 1, "maxLength": 1000},
                  "rank": {"type": "integer", "minimum": 0},
                  "visibility": {"enum": ["accepted", "diagnostic"]},
                  "extraction": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "outcome",
                          "artifact_disposition",
                          "artifact_ref",
                          "rejection_code"
                        ],
                        "properties": {
                          "outcome": {"$ref": "#/$defs/outcome"},
                          "artifact_disposition": {
                            "enum": ["usable", "partial", "diagnostic_only", "none"]
                          },
                          "artifact_ref": {
                            "oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]
                          },
                          "rejection_code": {
                            "type": ["string", "null"],
                            "maxLength": 64
                          }
                        }
                      },
                      {"type": "null"}
                    ]
                  }
                }
              }
            },
            "citation_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/id"}
            },
            "answer": {"type": "null"}
          }
        },
        "synthesis_allowed": {"type": "boolean"},
        "delivery_allowed": {"type": "boolean"},
        "visible_labels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/shortLabel"}
        }
      }
    }
  }
}
